{"surah":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","numberOfAyahs":4,"revelationType":"Meccan","ayahs":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","transliteration":"Qul huwal laahu ahad","banglaTransliteration":"কুল হুওয়াল্লা-হু আহাদ।","bangla":"বলুন, তিনি আল্লাহ, এক,","english":"Say, \"He is Allah, [who is] One,"},{"number":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","transliteration":"Allah hus-samad","banglaTransliteration":"আল্লা-হুসসামাদ।","bangla":"আল্লাহ অমুখাপেক্ষী,","english":"Allah, the Eternal Refuge."},{"number":3,"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","transliteration":"Lam yalid wa lam yoolad","banglaTransliteration":"লাম ইয়ালিদ ওয়ালাম ইঊলাদ।","bangla":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি","english":"He neither begets nor is born,"},{"number":4,"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","transliteration":"Wa lam yakul-lahu kufuwan ahad","banglaTransliteration":"ওয়া লাম ইয়াকুল্লাহূকুফুওয়ান আহাদ।","bangla":"এবং তার সমতুল্য কেউ নেই।","english":"Nor is there to Him any equivalent.\""}]}
# ─── Clerk Authentication ────────────────────────────────────────────
# Create a free account at https://dashboard.clerk.com → Applications →
# your app → API Keys, then copy both keys into .env.local.
#
# Until these are set, the app runs in "guest mode" with no sign-in UI
# shown (safe to build & deploy without auth).

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# URL routing for the hosted auth flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── App ─────────────────────────────────────────────────────────────
# Public site URL (used for metadata/OG tags)
# NEXT_PUBLIC_SITE_URL=https://al-quran.example.com
